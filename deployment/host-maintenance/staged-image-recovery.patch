+def inspect_staged_candidate(staging, service_name, chosen):
+    """Discard a pruned observation without weakening the one-day delay."""
+    try:
+        return json.loads(output(['docker', 'image', 'inspect', chosen]))[0]
+    except subprocess.CalledProcessError as exc:
+        # Only an absent queued image is recoverable here. Daemon/permission
+        # failures and missing running images must still fail closed.
+        if 'No such image:' not in (exc.stderr or ''):
+            raise
+        pending = staging[service_name]['candidates']
+        for key in list(pending):
+            if pending[key]['image'] == chosen:
+                del pending[key]
+        print('Held: %s (staged image no longer available; observe again)' % service_name)
+        return None
+
